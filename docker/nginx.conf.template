map $http_upgrade $htd_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 443 ssl;
    server_name ${GAME_HOST};
    ssl_certificate /etc/letsencrypt/live/${GAME_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${GAME_HOST}/privkey.pem;

    location = /health {
        proxy_pass http://directory:2567;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        access_log off;
    }

    location = /matchmake/joinOrCreate/directory {
        if ($request_method != POST) { return 404; }
        proxy_pass http://directory:2567;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        access_log off;
    }

    location ~ "^/[A-Za-z0-9_-]{9}/[A-Za-z0-9_-]{9}$" {
        if ($request_method != GET) { return 404; }
        if ($http_upgrade !~* ^websocket$) { return 404; }
        proxy_pass http://directory:2567;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $htd_connection_upgrade;
        proxy_read_timeout 90s;
        access_log off;
    }

    location / {
        return 404;
    }
}

server {
    listen 80;
    server_name ${GAME_HOST};
    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }
    location / {
        return 301 https://${GAME_HOST}$request_uri;
    }
}
